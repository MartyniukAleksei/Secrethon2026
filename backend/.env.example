# Copy to backend/.env. Matches the Postgres from docker-compose.yml in the repo root.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secrethon

# Server-only agent credentials. Never put these in frontend/.env.
# Repo-root .env is loaded first; values here override it (including empty values).
TAVILY_API_KEY=
JEV_API_KEY=
JEV_MODEL=jev-latest
# GPT agent and review of JEV. GPT_API_KEY / TEAM_API_KEY are also accepted.
GPT_BASE_URL=
TEAM_KEY_GPT=
GPT_MODEL=gpt-6-luna
AGENT_ENABLED=true

# RAG: separate from the GPT generation gateway. No schema writes on chat requests.
RAG_ENABLED=true
RAG_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_DIMENSIONS=1024
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
# Local alternative: RAG_PROVIDER=local, model=intfloat/multilingual-e5-small, dimensions=384.

# HTTP MCP clients use Authorization: Bearer <MCP_API_KEY> at /mcp/.
# Local stdio clients do not need this key. HTTP is unavailable until it is set.
MCP_ENABLED=true
MCP_API_KEY=
# Public site URL; on Railway RAILWAY_PUBLIC_DOMAIN is detected automatically.
MCP_PUBLIC_URL=
# Additional allowed Host names (comma separated, without scheme or port).
MCP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
